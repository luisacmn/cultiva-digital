# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do site (usada nos links de confirmação de e-mail e compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endereço da vitrine mostrada na página inicial (opcional; sem ele, usa a primeira vitrine criada)
HOME_STORE_SLUG=

# Por padrão o cadastro fecha depois que a primeira vitrine é criada (só a MEI usa a plataforma).
# Para abrir para outras vendedoras no futuro, troque para true.
ALLOW_SIGNUPS=false
